import { ScrollView } from "std-widgets.slint";

export struct OutboundFile {
    name: string,
    path: string,
    size_formatted: string,
}

export struct OutboundPayload {
    files: [string],
    file_names: [string],
    file_details: [OutboundFile],
    total_size_formatted: string,
}

export struct DisplayedItem {
    id: string,
    name: string,
    device_type: string,
    endpoint: bool,
    state: string,
    pin_code: string,
    files: [string],
    text_description: string,
    text_payload: string,
    text_type: string,
    destination: string,
    total_bytes: int,
    ack_bytes: int,
}

export component MainWindow inherits Window {
    title: "rquickshare";
    background: root.dark_mode ? #0e1715 : #f0fdf4;
    default-font-family: "sans-serif";
    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 650px;
    min-height: 450px;

    in property <string> hostname: "Device name";
    in property <string> version: "0.11.5";
    in property <string> new_version: "";
    in property <string> visibility: "Visible"; // Visible, Invisible, Temporarily
    in property <bool> has_outbound_payload: false;
    in property <OutboundPayload> outbound_payload;
    in property <[DisplayedItem]> displayed_items;
    in property <bool> discovery_running: false;

    // Theme & Settings state
    in-out property <bool> dark_mode: false;
    in-out property <bool> settings_open: false;
    in-out property <bool> autostart: true;
    in-out property <bool> realclose: false;
    in-out property <bool> startminimized: false;
    in-out property <string> download_path: "";

    callback open-url(string);
    callback open-settings();
    callback invert-visibility();
    callback clear-sending();
    callback open-file-picker();
    callback send-info(string);
    callback send-cmd(string, string);
    callback remove-request(string);
    callback write-to-clipboard(string);
    callback set-autostart(bool);
    callback set-realclose(bool);
    callback set-startminimized(bool);
    callback set-dark-mode(bool);
    callback select-download-path();

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        // --- Heading Header (Heading.vue) ---
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 12px;
            padding-bottom: 12px;
            alignment: space-between;

            VerticalLayout {
                spacing: 1px;
                alignment: center;
                max-width: 260px;

                Text {
                    text: "Device name";
                    font-size: 13px;
                    color: root.dark_mode ? #94a3b8 : #475569;
                }
                Text {
                    text: root.hostname;
                    font-size: 19px;
                    font-weight: 600;
                    color: root.dark_mode ? #f8fafc : #0f172a;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                // Version display
                Rectangle {
                    border-radius: 12px;
                    background: ver_touch.has_hover && root.new_version != "" ? (root.dark_mode ? #ffffff18 : #00000010) : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: center;

                        if root.new_version != "": Text {
                            text: "Update available";
                            font-size: 14px;
                            color: #22c55e;
                            font-weight: 500;
                        }
                        Text {
                            text: "v" + root.version;
                            font-size: 14px;
                            color: root.dark_mode ? #cbd5e1 : #334155;
                        }
                        if root.new_version != "": Text {
                            text: "→";
                            font-size: 16px;
                            color: #22c55e;
                        }
                        if root.new_version != "": Text {
                            text: "v" + root.new_version;
                            font-size: 14px;
                            color: #22c55e;
                            font-weight: 500;
                        }
                    }

                    ver_touch := TouchArea {
                        clicked => {
                            if (root.new_version != "") {
                                root.open-url("https://github.com/Martichou/rquickshare/releases/latest");
                            }
                        }
                    }
                }

                // Dark / Light Theme Toggle Button
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: theme_touch.has_hover ? (root.dark_mode ? #ffffff20 : #00000015) : (root.dark_mode ? #ffffff10 : #0000000a);
                    animate background { duration: 150ms; }

                    if root.dark_mode: Path {
                        width: 22px;
                        height: 22px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        fill: #fbbf24;
                        commands: "M 12 7 A 5 5 0 1 0 12 17 A 5 5 0 1 0 12 7 Z M 12 1 L 12 4 M 12 20 L 12 23 M 4.22 4.22 L 6.34 6.34 M 17.66 17.66 L 19.78 19.78 M 1 12 L 4 12 M 20 12 L 23 12 M 4.22 19.78 L 6.34 17.66 M 17.66 6.34 L 19.78 4.22";
                    }

                    if !root.dark_mode: Path {
                        width: 20px;
                        height: 20px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        fill: #334155;
                        commands: "M 12 3 C 7.03 3 3 7.03 3 12 C 3 16.97 7.03 21 12 21 C 15.65 21 18.76 18.82 20.14 15.68 C 19.46 15.89 18.74 16 18 16 C 13.58 16 10 12.42 10 8 C 10 6.13 10.64 4.41 11.72 3.05 C 11.81 3.03 11.91 3.02 12 3 Z";
                    }

                    theme_touch := TouchArea {
                        clicked => {
                            root.dark_mode = !root.dark_mode;
                            root.set-dark-mode(root.dark_mode);
                        }
                    }
                }

                // Settings button (Gear)
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: gear_touch.has_hover ? (root.dark_mode ? #ffffff20 : #00000015) : (root.dark_mode ? #ffffff10 : #0000000a);
                    animate background { duration: 150ms; }

                    Path {
                        width: 22px;
                        height: 22px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        fill: root.dark_mode ? #f8fafc : #0f172a;
                        commands: "M 9.25 22 L 8.85 18.8 Q 8.525 18.675 8.237 18.5 T 7.675 18.125 L 4.7 19.375 L 1.95 14.625 L 4.525 12.675 Q 4.5 12.5 4.5 12.338 V 11.662 Q 4.5 11.5 4.525 11.325 L 1.95 9.375 L 4.7 4.625 L 7.675 5.875 Q 7.95 5.675 8.238 5.5 T 8.85 5.2 L 9.25 2 H 14.75 L 15.15 5.2 Q 15.475 5.325 15.763 5.5 T 16.325 5.875 L 19.3 4.625 L 22.05 9.375 L 19.475 11.325 Q 19.5 11.5 19.5 11.662 V 12.338 Q 19.5 12.5 19.475 12.675 L 22.05 14.625 L 19.3 19.375 L 16.325 18.125 Q 16.05 18.325 15.762 18.5 T 15.15 18.8 L 14.75 22 Z M 11 20 H 13 L 13.35 17.35 Q 14.125 17.15 14.787 16.762 T 15.975 15.825 L 18.45 16.85 L 19.425 15.15 L 17.275 13.525 Q 17.4 13.175 17.45 12.788 T 17.5 12 Q 17.5 11.6 17.45 11.212 T 17.275 10.475 L 19.425 8.85 L 18.45 7.15 L 15.975 8.2 Q 15.425 7.625 14.762 7.237 T 13.35 6.65 L 13 4 H 11 L 10.65 6.65 Q 9.875 6.85 9.213 7.237 T 8.025 8.175 L 5.55 7.15 L 4.575 8.85 L 6.725 10.45 Q 6.6 10.825 6.55 11.2 T 6.5 12 Q 6.5 12.4 6.55 12.775 T 6.725 13.525 L 4.575 15.15 L 5.55 16.85 L 8.025 15.8 Q 8.575 16.375 9.238 16.762 T 10.65 17.35 Z M 12 15.5 Q 13.45 15.5 14.475 14.475 T 15.5 12 Q 15.5 10.55 14.475 9.525 T 12 8.5 Q 10.525 8.5 9.512 9.525 T 8.5 12 Q 8.5 13.45 9.513 14.475 T 12 15.5 Z";
                    }

                    gear_touch := TouchArea {
                        clicked => { root.settings_open = true; }
                    }
                }
            }
        }

        // --- Main Section (SideMenu + Content Area) ---
        HorizontalLayout {
            vertical-stretch: 1;

            // SideMenu (SideMenu.vue, w-72 = 288px)
            Rectangle {
                width: 288px;
                horizontal-stretch: 0;
                vertical-stretch: 1;

                if !root.has_outbound_payload: VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    padding-left: 24px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 24px;
                    alignment: start;
                    spacing: 8px;

                    Text {
                        text: "Visibility state";
                        font-size: 13px;
                        color: root.dark_mode ? #94a3b8 : #475569;
                    }

                    // Visibility Toggle Button (.btn)
                    Rectangle {
                        background: vis_touch.has_hover ? (root.dark_mode ? #ffffff1c : #00000015) : (root.dark_mode ? #ffffff0e : #0000000a);
                        border-radius: 12px;
                        height: 48px;
                        animate background { duration: 150ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;

                            Text {
                                text: root.visibility == "Visible" ? "Always visible" : (root.visibility == "Invisible" ? "Hidden from everyone" : "Temporarily visible");
                                font-weight: 500;
                                font-size: 15px;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                                vertical-alignment: center;
                            }

                            // Right Arrow Chevron (SideMenu.vue)
                            Text {
                                text: root.visibility == "Invisible" ? "‹" : "›";
                                font-size: 24px;
                                font-weight: 600;
                                color: root.dark_mode ? #94a3b8 : #475569;
                                vertical-alignment: center;
                            }
                        }

                        vis_touch := TouchArea {
                            clicked => { root.invert-visibility(); }
                        }
                    }

                    Text {
                        text: root.visibility == "Visible" ? "Nearby devices can share files with you, but you'll always be notified and have to approve each transfer before receiving it." : (root.visibility == "Invisible" ? "No one can see your device at the moment. However, keep in mind that if another device has saved yours before, it might still attempt to start a transfer with you.\n\nYou will get a notification when someone nearby is sharing giving you the ability to become visible for 1 minute." : "You are temporarily visible to everyone.");
                        font-size: 12px;
                        color: root.dark_mode ? #94a3b8 : #64748b;
                        wrap: word-wrap;
                    }
                }

                if root.has_outbound_payload: VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    padding-left: 24px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 24px;
                    spacing: 12px;

                    // 1. Header (fixed height)
                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: space-between;

                        Text {
                            text: "Sharing " + root.outbound_payload.files.length + " file" + (root.outbound_payload.files.length == 1 ? "" : "s");
                            font-size: 13px;
                            color: root.dark_mode ? #94a3b8 : #475569;
                            vertical-alignment: center;
                        }

                        if root.outbound_payload.total_size_formatted != "": Rectangle {
                            border-radius: 12px;
                            background: root.dark_mode ? #14532d : #dcfce7;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 3px;
                                padding-bottom: 3px;

                                Text {
                                    text: root.outbound_payload.total_size_formatted;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.dark_mode ? #4ade80 : #15803d;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 2. ScrollView (stretches to fill all remaining vertical space)
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            alignment: start;
                            spacing: 8px;

                            for item in root.outbound_payload.file_details: Rectangle {
                                background: root.dark_mode ? #1b2924 : #ffffff;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: root.dark_mode ? #253a31 : #f1f5f9;

                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        spacing: 8px;

                                        Text {
                                            text: item.name;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: root.dark_mode ? #f8fafc : #0f172a;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: item.size_formatted;
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: root.dark_mode ? #94a3b8 : #64748b;
                                            horizontal-alignment: right;
                                            horizontal-stretch: 0;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: item.path;
                                        font-size: 10px;
                                        font-family: "monospace";
                                        color: root.dark_mode ? #64748b : #94a3b8;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // 3. Helper Note (fixed height)
                    Text {
                        vertical-stretch: 0;
                        text: "Make sure both devices are unlocked, close together, and have bluetooth turned on. Device you're sharing with need Quick Share turned on and visible to you.";
                        font-size: 11px;
                        color: root.dark_mode ? #94a3b8 : #64748b;
                        wrap: word-wrap;
                    }

                    // 4. Action Buttons (fixed height: 40px)
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        height: 40px;

                        // Cancel button
                        Rectangle {
                            background: cancel_touch.has_hover ? (root.dark_mode ? #ffffff20 : #00000015) : (root.dark_mode ? #ffffff10 : #0000000a);
                            border-radius: 12px;
                            width: 80px;
                            animate background { duration: 150ms; }

                            Text {
                                text: "Cancel";
                                font-weight: 500;
                                font-size: 13px;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            cancel_touch := TouchArea {
                                clicked => { root.clear-sending(); }
                            }
                        }

                        // + Add files button
                        Rectangle {
                            background: add_touch.has_hover ? (root.dark_mode ? #22c55e30 : #dcfce7) : (root.dark_mode ? #22c55e20 : #e2fbe8);
                            border-radius: 12px;
                            horizontal-stretch: 1;
                            animate background { duration: 150ms; }

                            Text {
                                text: "+ Add files";
                                font-weight: 600;
                                font-size: 13px;
                                color: root.dark_mode ? #4ade80 : #16a34a;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            add_touch := TouchArea {
                                clicked => { root.open-file-picker(); }
                            }
                        }
                    }
                }
            }

            // --- Main Content Area (rounded-tl-[3rem] bg-white) ---
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                border-top-left-radius: 48px;
                background: root.dark_mode ? #16221e : #ffffff;
                clip: true;

                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    padding-left: 48px;
                    padding-right: 48px;
                    padding-top: 40px;
                    padding-bottom: 32px;
                    spacing: 20px;

                    Text {
                        vertical-stretch: 0;
                        text: root.displayed_items.length == 0 ? (root.has_outbound_payload ? "Ready to receive / send" : "Ready to receive") : "Nearby devices";
                        font-weight: 600;
                        font-size: 20px;
                        color: root.dark_mode ? #f8fafc : #0f172a;
                    }

                    // Empty state (no devices / transfers active): Radar pulse
                    if root.displayed_items.length == 0: Rectangle {
                        vertical-stretch: 1;
                        min-height: 140px;

                        Rectangle {
                            width: 140px;
                            height: 140px;
                            border-radius: 70px;
                            background: root.dark_mode ? #22c55e10 : #16a34a0a;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        Rectangle {
                            width: 90px;
                            height: 90px;
                            border-radius: 45px;
                            background: root.dark_mode ? #22c55e20 : #16a34a15;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: #22c55e;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: #ffffff;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }

                    // Displayed items list (devices & transfers)
                    if root.displayed_items.length > 0: ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 16px;

                            for item in root.displayed_items: Rectangle {
                                background: root.dark_mode ? #1d2c26 : #dcfce7;
                                border-width: 1px;
                                border-color: root.dark_mode ? #2b4036 : #bbf7d0;
                                border-radius: 20px;

                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 20px;

                                    // ItemSide
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Rectangle {
                                            width: 54px;
                                            height: 54px;
                                            border-radius: 27px;
                                            background: root.dark_mode ? #141f1b : #ffffff;

                                            // Device icon SVG
                                            if item.state == "Finished": Path {
                                                width: 24px;
                                                height: 24px;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: #22c55e;
                                                commands: "M 9 17.2 L 3.4 11.6 L 4.8 10.2 L 9 14.4 L 19.2 4.2 L 20.6 5.6 Z";
                                            }

                                            if item.state != "Finished" && item.device_type == "Phone": Path {
                                                width: 24px;
                                                height: 24px;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: root.dark_mode ? #f8fafc : #0f172a;
                                                commands: "M 7 23 Q 6.175 23 5.587 22.413 T 5 21 V 3 Q 5 2.175 5.587 1.587 T 7 1 H 17 Q 17.825 1 18.413 1.587 T 19 3 V 21 Q 19 21.825 18.413 22.413 T 17 23 Z M 7 18 H 17 V 5 H 7 Z";
                                            }

                                            if item.state != "Finished" && item.device_type == "Laptop": Path {
                                                width: 24px;
                                                height: 24px;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: root.dark_mode ? #f8fafc : #0f172a;
                                                commands: "M 0 20 V 18 H 4 V 6 Q 4 5.175 4.587 4.587 T 6 4 H 18 Q 18.825 4 19.413 4.587 T 20 6 V 18 H 24 V 20 Z M 6 16 H 18 V 6 H 6 Z";
                                            }

                                            if item.state != "Finished" && item.device_type == "Tablet": Path {
                                                width: 24px;
                                                height: 24px;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: root.dark_mode ? #f8fafc : #0f172a;
                                                commands: "M 4 23 Q 3.175 23 2.587 22.413 T 2 21 V 3 Q 2 2.175 2.588 1.587 T 4 1 H 20 Q 20.825 1 21.413 1.587 T 22 3 V 21 Q 22 21.825 21.413 22.413 T 20 23 Z M 4 19 H 20 V 5 H 4 Z";
                                            }

                                            if item.state != "Finished" && item.device_type != "Phone" && item.device_type != "Laptop" && item.device_type != "Tablet": Path {
                                                width: 24px;
                                                height: 24px;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 24;
                                                viewbox-height: 24;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: root.dark_mode ? #f8fafc : #0f172a;
                                                commands: "M 2 20 V 4 Q 2 3.175 2.587 2.588 T 4 2 H 20 Q 20.825 2 21.413 2.588 T 22 4 V 20 Z M 4 18 H 20 V 4 H 4 Z";
                                            }
                                        }

                                        if item.pin_code != "": Text {
                                            text: item.pin_code;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: root.dark_mode ? #4ade80 : #15803d;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // ItemBody
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        horizontal-stretch: 1;

                                        HorizontalLayout {
                                            alignment: space-between;

                                            Text {
                                                text: item.name;
                                                font-weight: 600;
                                                font-size: 16px;
                                                color: root.dark_mode ? #f8fafc : #0f172a;
                                                overflow: elide;
                                            }

                                            if item.endpoint: Text {
                                                text: root.has_outbound_payload ? "Click to send" : "Select files to send";
                                                font-size: 12px;
                                                color: root.dark_mode ? #4ade80 : #16a34a;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // State: WaitingForUserConsent
                                        if item.state == "WaitingForUserConsent": VerticalLayout {
                                            spacing: 8px;

                                            Text {
                                                text: item.files.length > 0 ? ("Wants to share " + item.files.length + " file" + (item.files.length == 1 ? "" : "s")) : ("Wants to share " + item.text_description);
                                                font-size: 13px;
                                                color: root.dark_mode ? #cbd5e1 : #334155;
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;

                                                // Accept button
                                                Rectangle {
                                                    background: #22c55e;
                                                    border-radius: 10px;
                                                    height: 36px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Accept"; color: #ffffff; font-weight: 600; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.send-cmd(item.id, "AcceptTransfer"); } }
                                                }

                                                // Reject button
                                                Rectangle {
                                                    background: root.dark_mode ? #263831 : #ffffff;
                                                    border-radius: 10px;
                                                    height: 36px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Decline"; color: root.dark_mode ? #f8fafc : #0f172a; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.send-cmd(item.id, "RejectTransfer"); } }
                                                }
                                            }
                                        }

                                        // State: Progress
                                        if item.state == "SendingFiles" || item.state == "ReceivingFiles": VerticalLayout {
                                            spacing: 6px;

                                            // Progress bar
                                            Rectangle {
                                                height: 8px;
                                                border-radius: 4px;
                                                background: root.dark_mode ? #ffffff15 : #00000015;

                                                Rectangle {
                                                    x: 0px;
                                                    y: 0px;
                                                    height: 100%;
                                                    border-radius: 4px;
                                                    background: #22c55e;
                                                    width: item.total_bytes > 0 ? parent.width * (item.ack_bytes / item.total_bytes) : 0px;
                                                }
                                            }

                                            HorizontalLayout {
                                                alignment: space-between;

                                                Text {
                                                    text: item.state == "SendingFiles" ? "Sending..." : "Receiving...";
                                                    font-size: 12px;
                                                    color: root.dark_mode ? #cbd5e1 : #475569;
                                                }

                                                Rectangle {
                                                    background: root.dark_mode ? #263831 : #ffffff;
                                                    border-radius: 10px;
                                                    height: 32px;
                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        Text { text: "Cancel"; color: root.dark_mode ? #f8fafc : #0f172a; font-weight: 500; font-size: 13px; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.send-cmd(item.id, "CancelTransfer"); } }
                                                }
                                            }
                                        }

                                        // State: Finished
                                        if item.state == "Finished": VerticalLayout {
                                            spacing: 8px;

                                            Text {
                                                text: item.destination != "" ? "Files received successfully" : "Transfer complete";
                                                font-size: 13px;
                                                color: root.dark_mode ? #cbd5e1 : #334155;
                                            }

                                            HorizontalLayout {
                                                alignment: end;
                                                spacing: 8px;

                                                if item.text_payload != "": Rectangle {
                                                    background: root.dark_mode ? #263831 : #ffffff;
                                                    border-radius: 10px;
                                                    height: 34px;
                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        Text { text: "Copy"; color: root.dark_mode ? #f8fafc : #0f172a; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.write-to-clipboard(item.text_payload); } }
                                                }

                                                Rectangle {
                                                    background: root.dark_mode ? #263831 : #ffffff;
                                                    border-radius: 10px;
                                                    height: 34px;
                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        Text { text: "Clear"; color: root.dark_mode ? #f8fafc : #0f172a; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.remove-request(item.id); } }
                                                }
                                            }
                                        }

                                        // State: Cancelled / Rejected / Disconnected
                                        if item.state == "Cancelled" || item.state == "Rejected" || item.state == "Disconnected": VerticalLayout {
                                            spacing: 6px;

                                            Text {
                                                text: item.state == "Cancelled" ? "Transfer cancelled" : (item.state == "Rejected" ? "Transfer rejected" : "Unexpected disconnection");
                                                font-size: 13px;
                                                color: root.dark_mode ? #cbd5e1 : #475569;
                                            }

                                            HorizontalLayout {
                                                alignment: end;

                                                Rectangle {
                                                    background: root.dark_mode ? #263831 : #ffffff;
                                                    border-radius: 10px;
                                                    height: 34px;
                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        Text { text: "Clear"; color: root.dark_mode ? #f8fafc : #0f172a; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.remove-request(item.id); } }
                                                }
                                            }
                                        }
                                    }
                                }

                                if item.endpoint: TouchArea {
                                    clicked => {
                                        if (root.has_outbound_payload) {
                                            root.send-info(item.id);
                                        } else {
                                            root.open-file-picker();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Drop files box (shown whenever user hasn't selected files yet)
                    if !root.has_outbound_payload: Rectangle {
                        vertical-stretch: 0;
                        height: 160px;
                        border-width: 1.5px;
                        border-color: drop_touch.has_hover ? #22c55e : (root.dark_mode ? #2c3e37 : #e2e8f0);
                        border-radius: 18px;
                        background: drop_touch.has_hover ? (root.dark_mode ? #1c2e27 : #f0fdf4) : (root.dark_mode ? #131c19 : transparent);
                        animate background { duration: 150ms; }
                        animate border-color { duration: 150ms; }

                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: center;
                                Path {
                                    width: 32px;
                                    height: 32px;
                                    viewbox-x: 0;
                                    viewbox-y: 0;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    fill: drop_touch.has_hover ? #22c55e : (root.dark_mode ? #4ade80 : #334155);
                                    commands: "M 11 16 V 7.85 L 8.4 10.45 L 7 9 L 12 4 L 17 9 L 15.6 10.45 L 13 7.85 V 16 Z M 6 20 Q 5.175 20 4.588 19.413 T 4 18 V 15 H 6 V 18 H 18 V 15 H 20 V 18 Q 20 18.825 19.413 19.413 T 18 20 Z";
                                }
                            }

                            Text {
                                text: "Drop files here to send";
                                font-size: 15px;
                                font-weight: 600;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    background: select_touch.has_hover ? (root.dark_mode ? #ffffff20 : #00000015) : (root.dark_mode ? #ffffff10 : #0000000a);
                                    border-radius: 12px;
                                    height: 36px;
                                    width: 104px;
                                    animate background { duration: 150ms; }

                                    Text {
                                        text: "+  Select";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: root.dark_mode ? #f8fafc : #0f172a;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    select_touch := TouchArea {
                                        clicked => { root.open-file-picker(); }
                                    }
                                }
                            }
                        }

                        drop_touch := TouchArea {
                            clicked => { root.open-file-picker(); }
                        }
                    }
                }
            }
        }
    }

    // --- Settings Modal Dialog Overlay ---
    if root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000070;

        TouchArea {
            // Block background clicks
        }

        Rectangle {
            width: 400px;
            background: root.dark_mode ? #182420 : #ffffff;
            border-width: 1px;
            border-color: root.dark_mode ? #2b3e36 : #f1f5f9;
            border-radius: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Title and Close button
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Settings";
                        font-weight: 600;
                        font-size: 20px;
                        color: root.dark_mode ? #f8fafc : #0f172a;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        background: close_touch.has_hover ? (root.dark_mode ? #ffffff20 : #00000015) : (root.dark_mode ? #ffffff10 : #0000000a);
                        border-radius: 10px;
                        height: 34px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "Close";
                                font-weight: 500;
                                font-size: 13px;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                                vertical-alignment: center;
                            }
                        }
                        close_touch := TouchArea {
                            clicked => { root.settings_open = false; }
                        }
                    }
                }

                // Options list
                VerticalLayout {
                    spacing: 4px;

                    // Option 1: Start on boot
                    Rectangle {
                        border-radius: 10px;
                        background: opt1_touch.has_hover ? (root.dark_mode ? #ffffff0d : #0000000a) : transparent;
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: "Start on boot";
                                font-size: 14px;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                                vertical-alignment: center;
                            }

                            // Checkbox
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.autostart ? #22c55e : (root.dark_mode ? #384e44 : #cbd5e1);
                                background: root.autostart ? #22c55e : (root.dark_mode ? #22322c : #ffffff);
                                y: (parent.height - self.height) / 2;

                                if root.autostart: Text {
                                    text: "✓";
                                    font-size: 13px;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }

                        opt1_touch := TouchArea {
                            clicked => {
                                root.autostart = !root.autostart;
                                root.set-autostart(root.autostart);
                            }
                        }
                    }

                    // Option 2: Keep running on close
                    Rectangle {
                        border-radius: 10px;
                        background: opt2_touch.has_hover ? (root.dark_mode ? #ffffff0d : #0000000a) : transparent;
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: "Keep running on close";
                                font-size: 14px;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: !root.realclose ? #22c55e : (root.dark_mode ? #384e44 : #cbd5e1);
                                background: !root.realclose ? #22c55e : (root.dark_mode ? #22322c : #ffffff);
                                y: (parent.height - self.height) / 2;

                                if !root.realclose: Text {
                                    text: "✓";
                                    font-size: 13px;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }

                        opt2_touch := TouchArea {
                            clicked => {
                                root.realclose = !root.realclose;
                                root.set-realclose(root.realclose);
                            }
                        }
                    }

                    // Option 3: Start minimized
                    Rectangle {
                        border-radius: 10px;
                        background: opt3_touch.has_hover ? (root.dark_mode ? #ffffff0d : #0000000a) : transparent;
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: "Start minimized";
                                font-size: 14px;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.startminimized ? #22c55e : (root.dark_mode ? #384e44 : #cbd5e1);
                                background: root.startminimized ? #22c55e : (root.dark_mode ? #22322c : #ffffff);
                                y: (parent.height - self.height) / 2;

                                if root.startminimized: Text {
                                    text: "✓";
                                    font-size: 13px;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }

                        opt3_touch := TouchArea {
                            clicked => {
                                root.startminimized = !root.startminimized;
                                root.set-startminimized(root.startminimized);
                            }
                        }
                    }

                    // Option 4: Dark mode
                    Rectangle {
                        border-radius: 10px;
                        background: opt_dark_touch.has_hover ? (root.dark_mode ? #ffffff0d : #0000000a) : transparent;
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: "Dark mode";
                                font-size: 14px;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.dark_mode ? #22c55e : (root.dark_mode ? #384e44 : #cbd5e1);
                                background: root.dark_mode ? #22c55e : (root.dark_mode ? #22322c : #ffffff);
                                y: (parent.height - self.height) / 2;

                                if root.dark_mode: Text {
                                    text: "✓";
                                    font-size: 13px;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }

                        opt_dark_touch := TouchArea {
                            clicked => {
                                root.dark_mode = !root.dark_mode;
                                root.set-dark-mode(root.dark_mode);
                            }
                        }
                    }

                    // Option 5: Change download folder
                    Rectangle {
                        border-radius: 10px;
                        background: opt4_touch.has_hover ? (root.dark_mode ? #ffffff0d : #0000000a) : transparent;
                        height: 52px;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "Change download folder";
                                font-size: 14px;
                                color: root.dark_mode ? #f8fafc : #0f172a;
                            }

                            Text {
                                text: root.download_path != "" ? ("> " + root.download_path) : "> OS User's download folder";
                                font-size: 12px;
                                color: root.dark_mode ? #94a3b8 : #64748b;
                                overflow: elide;
                            }
                        }

                        opt4_touch := TouchArea {
                            clicked => {
                                root.select-download-path();
                            }
                        }
                    }
                }
            }
        }
    }
}
