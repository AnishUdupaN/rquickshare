export struct OutboundPayload {
    files: [string],
}

export struct DisplayedItem {
    id: string,
    name: string,
    device_type: string,
    endpoint: bool,
    state: string,
    pin_code: string,
    files: [string],
    text_description: string,
    text_payload: string,
    text_type: string,
    destination: string,
    total_bytes: int,
    ack_bytes: int,
}

component RippleCircle inherits Rectangle {
    in property <length> base_size: 24px;
    in property <float> target_scale: 3.5;
    in property <duration> anim_duration: 3000ms;
    in property <duration> anim_delay: 0ms;

    width: base_size;
    height: base_size;
    border-radius: base_size / 2;
    background: #000000;
    opacity: 0.12;
}

export component MainWindow inherits Window {
    title: "rquickshare";
    width: 900px;
    height: 600px;
    background: #f0fdf4; // bg-green-50
    default-font-family: "sans-serif";

    in property <string> hostname: "Device name";
    in property <string> version: "0.11.5";
    in property <string> new_version: "";
    in property <string> visibility: "Visible"; // Visible, Invisible, Temporarily
    in property <bool> has_outbound_payload: false;
    in property <OutboundPayload> outbound_payload;
    in property <[DisplayedItem]> displayed_items;
    in property <bool> discovery_running: false;

    // Settings state
    in-out property <bool> settings_open: false;
    in-out property <bool> autostart: true;
    in-out property <bool> realclose: false;
    in-out property <bool> startminimized: false;
    in-out property <string> download_path: "";

    callback open-url(string);
    callback open-settings();
    callback invert-visibility();
    callback clear-sending();
    callback open-file-picker();
    callback send-info(string);
    callback send-cmd(string, string);
    callback remove-request(string);
    callback write-to-clipboard(string);
    callback set-autostart(bool);
    callback set-realclose(bool);
    callback set-startminimized(bool);
    callback select-download-path();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // --- Heading Header (Heading.vue) ---
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 16px;
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                Text {
                    text: "Device name";
                    font-size: 14px;
                    color: #000000;
                }
                Text {
                    text: root.hostname;
                    font-size: 24px;
                    font-weight: 500;
                    color: #000000;
                }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: center;

                // Version display
                Rectangle {
                    border-radius: 12px;
                    background: ver_touch.has_hover && root.new_version != "" ? #00000010 : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: center;

                        if root.new_version != "": Text {
                            text: "Update available";
                            font-size: 14px;
                            color: #16a34a;
                            font-weight: 500;
                        }
                        Text {
                            text: "v" + root.version;
                            font-size: 14px;
                            color: #000000;
                        }
                        if root.new_version != "": Text {
                            text: "→";
                            font-size: 18px;
                            color: #16a34a;
                        }
                        if root.new_version != "": Text {
                            text: "v" + root.new_version;
                            font-size: 14px;
                            color: #16a34a;
                            font-weight: 500;
                        }
                    }

                    ver_touch := TouchArea {
                        clicked => {
                            if (root.new_version != "") {
                                root.open-url("https://github.com/Martichou/rquickshare/releases/latest");
                            }
                        }
                    }
                }

                // Settings button (Gear)
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: gear_touch.has_hover ? #00000015 : #0000000a;
                    animate background { duration: 150ms; }

                    // SVG Gear Icon from Heading.vue
                    Path {
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        fill: #000000;
                        // viewBox: 0 -960 960 960 scaled to 24x24: scale factor 0.025, offset y by 24
                        commands: "M 9.25 22 L 8.85 18.8 Q 8.525 18.675 8.237 18.5 T 7.675 18.125 L 4.7 19.375 L 1.95 14.625 L 4.525 12.675 Q 4.5 12.5 4.5 12.338 V 11.662 Q 4.5 11.5 4.525 11.325 L 1.95 9.375 L 4.7 4.625 L 7.675 5.875 Q 7.95 5.675 8.238 5.5 T 8.85 5.2 L 9.25 2 H 14.75 L 15.15 5.2 Q 15.475 5.325 15.763 5.5 T 16.325 5.875 L 19.3 4.625 L 22.05 9.375 L 19.475 11.325 Q 19.5 11.5 19.5 11.662 V 12.338 Q 19.5 12.5 19.475 12.675 L 22.05 14.625 L 19.3 19.375 L 16.325 18.125 Q 16.05 18.325 15.762 18.5 T 15.15 18.8 L 14.75 22 Z M 11 20 H 13 L 13.35 17.35 Q 14.125 17.15 14.787 16.762 T 15.975 15.825 L 18.45 16.85 L 19.425 15.15 L 17.275 13.525 Q 17.4 13.175 17.45 12.788 T 17.5 12 Q 17.5 11.6 17.45 11.212 T 17.275 10.475 L 19.425 8.85 L 18.45 7.15 L 15.975 8.2 Q 15.425 7.625 14.762 7.237 T 13.35 6.65 L 13 4 H 11 L 10.65 6.65 Q 9.875 6.85 9.213 7.237 T 8.025 8.175 L 5.55 7.15 L 4.575 8.85 L 6.725 10.45 Q 6.6 10.825 6.55 11.2 T 6.5 12 Q 6.5 12.4 6.55 12.775 T 6.725 13.525 L 4.575 15.15 L 5.55 16.85 L 8.025 15.8 Q 8.575 16.375 9.238 16.762 T 10.65 17.35 Z M 12 15.5 Q 13.45 15.5 14.475 14.475 T 15.5 12 Q 15.5 10.55 14.475 9.525 T 12 8.5 Q 10.525 8.5 9.512 9.525 T 8.5 12 Q 8.5 13.45 9.513 14.475 T 12 15.5 Z";
                    }

                    gear_touch := TouchArea {
                        clicked => { root.settings_open = true; }
                    }
                }
            }
        }

        // --- Main Section (SideMenu + Content Area) ---
        HorizontalLayout {
            // SideMenu (SideMenu.vue, w-72 = 288px)
            VerticalLayout {
                width: 288px;
                padding-left: 24px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 24px;

                if !root.has_outbound_payload: VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "Visibility state";
                        font-size: 14px;
                        color: #000000;
                    }

                    // Visibility Toggle Button (.btn)
                    Rectangle {
                        background: vis_touch.has_hover ? #00000015 : #0000000a;
                        border-radius: 12px;
                        height: 48px;
                        animate background { duration: 150ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;

                            Text {
                                text: root.visibility == "Visible" ? "Always visible" : (root.visibility == "Invisible" ? "Hidden from everyone" : "Temporarily visible");
                                font-weight: 500;
                                font-size: 15px;
                                color: #000000;
                                vertical-alignment: center;
                            }

                            // Right Arrow Chevron (SideMenu.vue)
                            Path {
                                width: 24px;
                                height: 24px;
                                fill: #000000;
                                commands: "M 12.6 12 L 8 7.4 L 9.4 6 L 15.4 12 L 9.4 18 L 8 16.6 Z";
                            }
                        }

                        vis_touch := TouchArea {
                            clicked => { root.invert-visibility(); }
                        }
                    }

                    Text {
                        text: root.visibility == "Visible" ? "Nearby devices can share files with you, but you'll always be notified and have to approve each transfer before receiving it." : (root.visibility == "Invisible" ? "No one can see your device at the moment. However, keep in mind that if another device has saved yours before, it might still attempt to start a transfer with you.\n\nYou will get a notification when someone nearby is sharing giving you the ability to become visible for 1 minute." : "You are temporarily visible to everyone.");
                        font-size: 12px;
                        color: #000000;
                        wrap: word-wrap;
                    }
                }

                if root.has_outbound_payload: VerticalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "Sharing " + root.outbound_payload.files.length + " file" + (root.outbound_payload.files.length == 1 ? "" : "s");
                            font-size: 14px;
                            color: #000000;
                        }

                        // File Icon square (bg-white w-32 h-32 rounded-2xl)
                        Rectangle {
                            width: 128px;
                            height: 128px;
                            background: #ffffff;
                            border-radius: 16px;

                            Path {
                                width: 32px;
                                height: 32px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                fill: #000000;
                                commands: "M 6 22 Q 5.175 22 4.587 21.413 T 4 20 V 4 Q 4 3.175 4.588 2.587 T 6 2 H 14 L 20 8 V 20 Q 20 20.825 19.413 21.413 T 18 22 Z M 13 9 V 4 H 6 V 20 H 18 V 9 Z";
                            }
                        }

                        for file in root.outbound_payload.files: Text {
                            text: file;
                            font-size: 13px;
                            color: #000000;
                            overflow: elide;
                        }

                        Text {
                            text: "Make sure both devices are unlocked, close together, and have bluetooth turned on. Device you're sharing with need Quick Share turned on and visible to you.";
                            font-size: 12px;
                            color: #000000;
                            wrap: word-wrap;
                        }
                    }

                    // Cancel button
                    Rectangle {
                        background: cancel_touch.has_hover ? #00000015 : #0000000a;
                        border-radius: 12px;
                        height: 44px;
                        width: 90px;
                        animate background { duration: 150ms; }

                        Text {
                            text: "Cancel";
                            font-weight: 500;
                            font-size: 14px;
                            color: #000000;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }

                        cancel_touch := TouchArea {
                            clicked => { root.clear-sending(); }
                        }
                    }
                }
            }

            // --- Main Content Area (rounded-tl-[3rem] bg-white) ---
            Rectangle {
                background: #ffffff;
                border-top-left-radius: 48px;

                VerticalLayout {
                    padding: 48px;
                    spacing: 16px;

                    Text {
                        text: root.displayed_items.length == 0 ? (root.has_outbound_payload ? "Ready to receive / send" : "Ready to receive") : "Nearby devices";
                        font-weight: 500;
                        font-size: 20px;
                        color: #000000;
                    }

                    // Radar pulse indicator when waiting to receive
                    if root.displayed_items.length == 0 && !root.has_outbound_payload: Rectangle {
                        height: 120px;

                        // Concentric circles representing pulse
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 80px;
                            height: 80px;
                            border-radius: 40px;
                            background: #00000008;
                        }
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 52px;
                            height: 52px;
                            border-radius: 26px;
                            background: #00000012;
                        }
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: #000000;
                        }
                    }

                    // Drop files box (ContentStatus.vue)
                    if root.displayed_items.length == 0 && !root.has_outbound_payload: Rectangle {
                        border-width: 1px;
                        border-color: #e2e8f0;
                        border-radius: 16px;
                        background: drop_touch.has_hover ? #f0fdf4 : transparent;
                        animate background { duration: 150ms; }

                        VerticalLayout {
                            padding: 24px;
                            alignment: center;
                            spacing: 8px;

                            Path {
                                width: 32px;
                                height: 32px;
                                fill: #000000;
                                commands: "M 11 16 V 7.85 L 8.4 10.45 L 7 9 L 12 4 L 17 9 L 15.6 10.45 L 13 7.85 V 16 Z M 6 20 Q 5.175 20 4.587 19.413 T 4 18 V 15 H 6 V 18 H 18 V 15 H 20 V 18 Q 20 18.825 19.413 19.413 T 18 20 Z";
                            }

                            Text {
                                text: "Drop files to send";
                                font-weight: 500;
                                font-size: 15px;
                                color: #000000;
                                horizontal-alignment: center;
                            }

                            // Select button
                            Rectangle {
                                background: #0000000a;
                                border-radius: 12px;
                                height: 44px;
                                width: 110px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    alignment: center;

                                    Path {
                                        width: 18px;
                                        height: 18px;
                                        fill: #000000;
                                        commands: "M 11 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 V 13 H 13 V 19 H 11 Z";
                                    }

                                    Text {
                                        text: "Select";
                                        font-weight: 500;
                                        font-size: 14px;
                                        color: #000000;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        drop_touch := TouchArea {
                            clicked => { root.open-file-picker(); }
                        }
                    }

                    // Displayed items list (devices & transfers)
                    ScrollView {
                        VerticalLayout {
                            spacing: 16px;

                            for item in root.displayed_items: Rectangle {
                                background: #dcfce7; // bg-green-100
                                border-radius: 24px; // rounded-3xl

                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 24px;

                                    // ItemSide (w-[62px] h-[62px])
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Rectangle {
                                            width: 56px;
                                            height: 56px;
                                            border-radius: 28px;
                                            background: #ffffff;

                                            // Device icon SVG
                                            if item.state == "Finished": Path {
                                                width: 24px;
                                                height: 24px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: #16a34a;
                                                commands: "M 9 17.2 L 3.4 11.6 L 4.8 10.2 L 9 14.4 L 19.2 4.2 L 20.6 5.6 Z";
                                            }

                                            if item.state != "Finished" && item.device_type == "Phone": Path {
                                                width: 24px;
                                                height: 24px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: #000000;
                                                commands: "M 7 23 Q 6.175 23 5.587 22.413 T 5 21 V 3 Q 5 2.175 5.587 1.587 T 7 1 H 17 Q 17.825 1 18.413 1.587 T 19 3 V 21 Q 19 21.825 18.413 22.413 T 17 23 Z M 7 18 H 17 V 5 H 7 Z";
                                            }

                                            if item.state != "Finished" && item.device_type == "Laptop": Path {
                                                width: 24px;
                                                height: 24px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: #000000;
                                                commands: "M 0 20 V 18 H 4 V 6 Q 4 5.175 4.587 4.587 T 6 4 H 18 Q 18.825 4 19.413 4.587 T 20 6 V 18 H 24 V 20 Z M 6 16 H 18 V 6 H 6 Z";
                                            }

                                            if item.state != "Finished" && item.device_type == "Tablet": Path {
                                                width: 24px;
                                                height: 24px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: #000000;
                                                commands: "M 3 20 Q 2.175 20 1.587 19.413 T 1 18 V 6 Q 1 5.175 1.587 4.587 T 3 4 H 21 Q 21.825 4 22.413 4.587 T 23 6 V 18 Q 23 18.825 22.413 19.413 T 21 20 Z M 5 18 H 19 V 6 H 5 Z";
                                            }

                                            if item.state != "Finished" && item.device_type != "Phone" && item.device_type != "Laptop" && item.device_type != "Tablet": Path {
                                                width: 24px;
                                                height: 24px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                fill: #000000;
                                                commands: "M 2 20 V 4 H 22 V 20 Z M 4 16 H 20 V 6 H 4 Z";
                                            }
                                        }

                                        if (item.state == "WaitingForUserConsent" || item.state == "SentIntroduction") && item.pin_code != "": Text {
                                            text: "🛡 " + item.pin_code;
                                            font-size: 13px;
                                            font-weight: 500;
                                            color: #000000;
                                            horizontal-alignment: center;
                                        }
                                    }

                                    // Content & Controls
                                    VerticalLayout {
                                        alignment: item.state == "" ? center : stretch;
                                        spacing: 4px;

                                        Text {
                                            text: item.name;
                                            font-weight: 500;
                                            font-size: 16px;
                                            color: #000000;
                                        }

                                        if item.state == "WaitingForUserConsent": VerticalLayout {
                                            spacing: 8px;

                                            Text {
                                                text: "Wants to share " + (item.files.length > 0 ? (item.files.length + " file(s)") : (item.text_description != "" ? item.text_description : "some file(s)."));
                                                font-size: 14px;
                                                color: #000000;
                                            }

                                            HorizontalLayout {
                                                alignment: end;
                                                spacing: 12px;

                                                Rectangle {
                                                    background: #ffffff;
                                                    border-radius: 12px;
                                                    height: 38px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Accept"; color: #000000; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.send-cmd(item.id, "AcceptTransfer"); } }
                                                }

                                                Rectangle {
                                                    background: #ffffff;
                                                    border-radius: 12px;
                                                    height: 38px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Decline"; color: #000000; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.send-cmd(item.id, "RejectTransfer"); } }
                                                }
                                            }
                                        }

                                        if item.state == "SentIntroduction" || item.state == "SendingFiles" || item.state == "ReceivingFiles": VerticalLayout {
                                            spacing: 6px;

                                            Text {
                                                text: item.state == "ReceivingFiles" ? "Receiving..." : "Sending...";
                                                font-size: 14px;
                                                color: #000000;
                                            }

                                            for f in item.files: Text {
                                                text: f;
                                                font-size: 13px;
                                                color: #000000;
                                                overflow: elide;
                                            }

                                            HorizontalLayout {
                                                alignment: end;

                                                Rectangle {
                                                    background: #ffffff;
                                                    border-radius: 12px;
                                                    height: 38px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Cancel"; color: #000000; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.send-cmd(item.id, "CancelTransfer"); } }
                                                }
                                            }
                                        }

                                        if item.state == "Finished": VerticalLayout {
                                            spacing: 6px;

                                            Text {
                                                text: item.text_type != "" ? "Received text" : "Received files";
                                                font-size: 14px;
                                                color: #000000;
                                            }

                                            for f in item.files: Text {
                                                text: f;
                                                font-size: 13px;
                                                color: #000000;
                                                overflow: elide;
                                            }

                                            if item.destination != "": Text {
                                                text: "Saved to " + item.destination;
                                                font-size: 13px;
                                                color: #000000;
                                                overflow: elide;
                                            }

                                            if item.text_payload != "": Text {
                                                text: item.text_payload;
                                                font-size: 13px;
                                                color: #000000;
                                                overflow: elide;
                                            }

                                            HorizontalLayout {
                                                alignment: end;
                                                spacing: 12px;

                                                if item.destination != "" || (item.text_type == "Url" && item.text_payload != ""): Rectangle {
                                                    background: #ffffff;
                                                    border-radius: 12px;
                                                    height: 38px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Open"; color: #000000; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.open-url(item.destination != "" ? item.destination : item.text_payload); } }
                                                }

                                                if item.text_type != "" && item.text_payload != "": Rectangle {
                                                    background: #ffffff;
                                                    border-radius: 12px;
                                                    height: 38px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Copy"; color: #000000; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.write-to-clipboard(item.text_payload); } }
                                                }

                                                Rectangle {
                                                    background: #ffffff;
                                                    border-radius: 12px;
                                                    height: 38px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Clear"; color: #000000; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.remove-request(item.id); } }
                                                }
                                            }
                                        }

                                        if item.state == "Cancelled" || item.state == "Rejected" || item.state == "Disconnected": VerticalLayout {
                                            spacing: 6px;

                                            Text {
                                                text: item.state == "Cancelled" ? "Transfer cancelled" : (item.state == "Rejected" ? "Transfer rejected" : "Unexpected disconnection");
                                                font-size: 14px;
                                                color: #000000;
                                            }

                                            HorizontalLayout {
                                                alignment: end;

                                                Rectangle {
                                                    background: #ffffff;
                                                    border-radius: 12px;
                                                    height: 38px;
                                                    HorizontalLayout {
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        Text { text: "Clear"; color: #000000; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    TouchArea { clicked => { root.remove-request(item.id); } }
                                                }
                                            }
                                        }
                                    }
                                }

                                if item.endpoint: TouchArea {
                                    clicked => { root.send-info(item.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // --- Settings Modal Dialog Overlay (1:1 with SettingsModal.vue) ---
    if root.settings_open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040; // bg-black bg-opacity-25

        TouchArea {
            // Block background clicks
        }

        Rectangle {
            width: 384px; // w-[24rem]
            background: #ffffff;
            border-radius: 16px; // rounded-xl
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 16px; // p-4
                spacing: 16px;

                // Title and Close button
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Settings";
                        font-weight: 500;
                        font-size: 20px;
                        color: #000000;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        background: close_touch.has_hover ? #00000015 : #0000000a;
                        border-radius: 12px;
                        height: 38px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: "Close";
                                font-weight: 500;
                                font-size: 14px;
                                color: #000000;
                                vertical-alignment: center;
                            }
                        }
                        close_touch := TouchArea {
                            clicked => { root.settings_open = false; }
                        }
                    }
                }

                // Options list (py-4 flex flex-col)
                VerticalLayout {
                    spacing: 4px;

                    // Option 1: Start on boot
                    Rectangle {
                        border-radius: 12px;
                        background: opt1_touch.has_hover ? #0000000a : transparent;
                        height: 48px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: "Start on boot";
                                font-size: 14px;
                                color: #000000;
                                vertical-alignment: center;
                            }

                            // Checkbox
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.autostart ? #86efac : #cbd5e1;
                                background: root.autostart ? #bbf7d0 : #ffffff;
                                y: (parent.height - self.height) / 2;

                                if root.autostart: Text {
                                    text: "✓";
                                    font-size: 14px;
                                    color: #000000;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }

                        opt1_touch := TouchArea {
                            clicked => {
                                root.autostart = !root.autostart;
                                root.set-autostart(root.autostart);
                            }
                        }
                    }

                    // Option 2: Keep running on close
                    Rectangle {
                        border-radius: 12px;
                        background: opt2_touch.has_hover ? #0000000a : transparent;
                        height: 48px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: "Keep running on close";
                                font-size: 14px;
                                color: #000000;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: !root.realclose ? #86efac : #cbd5e1;
                                background: !root.realclose ? #bbf7d0 : #ffffff;
                                y: (parent.height - self.height) / 2;

                                if !root.realclose: Text {
                                    text: "✓";
                                    font-size: 14px;
                                    color: #000000;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }

                        opt2_touch := TouchArea {
                            clicked => {
                                root.realclose = !root.realclose;
                                root.set-realclose(root.realclose);
                            }
                        }
                    }

                    // Option 3: Start minimized
                    Rectangle {
                        border-radius: 12px;
                        background: opt3_touch.has_hover ? #0000000a : transparent;
                        height: 48px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: "Start minimized";
                                font-size: 14px;
                                color: #000000;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.startminimized ? #86efac : #cbd5e1;
                                background: root.startminimized ? #bbf7d0 : #ffffff;
                                y: (parent.height - self.height) / 2;

                                if root.startminimized: Text {
                                    text: "✓";
                                    font-size: 14px;
                                    color: #000000;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }

                        opt3_touch := TouchArea {
                            clicked => {
                                root.startminimized = !root.startminimized;
                                root.set-startminimized(root.startminimized);
                            }
                        }
                    }

                    // Option 4: Change download folder
                    Rectangle {
                        border-radius: 12px;
                        background: opt4_touch.has_hover ? #0000000a : transparent;
                        height: 56px;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "Change download folder";
                                font-size: 14px;
                                color: #000000;
                            }

                            Text {
                                text: root.download_path != "" ? ("> " + root.download_path) : "> OS User's download folder";
                                font-size: 12px;
                                color: #64748b;
                                overflow: elide;
                            }
                        }

                        opt4_touch := TouchArea {
                            clicked => {
                                root.select-download-path();
                            }
                        }
                    }
                }
            }
        }
    }
}
